{
  "name": "@platformcosmo/pdf",
  "version": "0.1.2",
  "description": "Minimal hardened PDF parser for platformcosmo: pages, image placements, image extraction and text runs, with every hostile input bounded by a diagnostic.",
  "keywords": [
    "platformcosmo",
    "architecture-diagram",
    "isometric",
    "svg",
    "diagram",
    "pdf",
    "pdf-parser",
    "pdf-images"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
