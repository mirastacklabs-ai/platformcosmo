{
  "name": "@platformcosmo/icons-simple",
  "version": "0.0.2",
  "description": "Simple Icons brand icons limited to CC0-1.0 or Apache-2.0 (MIT excluded) as a platformcosmo icon pack (simple:*).",
  "keywords": [
    "platformcosmo",
    "architecture-diagram",
    "isometric",
    "svg",
    "diagram",
    "icons",
    "icon-pack",
    "simple-icons"
  ],
  "license": "(CC0-1.0 AND MIT AND Apache-2.0)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/icons-simple"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "LICENSE-SIMPLE-ICONS.txt",
    "DISCLAIMER-SIMPLE-ICONS.txt",
    "NOTICE-SIMPLE-ICONS.txt"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@platformcosmo/core": "workspace:*"
  }
}
