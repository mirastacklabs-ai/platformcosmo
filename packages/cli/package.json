{
  "name": "platformcosmo",
  "version": "0.1.2",
  "description": "Prompt in, animated isometric architecture diagram out: a CLI that renders cloud, AI, platform and data-center specs as self-contained animated SVG, PNG, GIF and MP4.",
  "keywords": [
    "platformcosmo",
    "architecture-diagram",
    "isometric",
    "svg",
    "diagram",
    "cli",
    "diagrams-as-code",
    "svg-animation",
    "cloud-architecture",
    "platform-engineering",
    "data-center",
    "kubernetes",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pcosmo": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "gen:examples": "node scripts/gen-examples.mjs",
    "gen:gallery": "node scripts/gen-gallery.mjs",
    "check:gallery": "node scripts/gen-gallery.mjs --check --min 6",
    "check:examples": "node scripts/gen-examples.mjs --check",
    "bundle:plugin": "node scripts/bundle-plugin.mjs",
    "check:plugin": "node scripts/bundle-plugin.mjs --check"
  },
  "dependencies": {
    "@platformcosmo/core": "workspace:*",
    "@platformcosmo/dc-pack": "workspace:*",
    "@platformcosmo/icons-base": "workspace:*",
    "@platformcosmo/icons-k8s": "workspace:*",
    "@platformcosmo/icons-lucide": "workspace:*",
    "@platformcosmo/icons-simple": "workspace:*",
    "@platformcosmo/parts-auto": "workspace:*",
    "@platformcosmo/parts-base": "workspace:*",
    "@platformcosmo/parts-brick": "workspace:*",
    "@platformcosmo/pdf": "workspace:*",
    "@platformcosmo/themes": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@platformcosmo/assets": "workspace:*",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2"
  }
}
