{
  "name": "@platformcosmo/parts-brick",
  "version": "0.1.2",
  "description": "brick: part shapes for platformcosmo assemblies: generic stud-grid bricks, plates, tiles, slopes and rounds for step-by-step build animations.",
  "keywords": [
    "platformcosmo",
    "architecture-diagram",
    "isometric",
    "svg",
    "diagram",
    "assembly",
    "build-animation",
    "bricks"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/parts-brick"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@platformcosmo/core": "workspace:*"
  }
}
