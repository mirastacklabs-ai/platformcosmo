              "distance": "auto",
              "order": "outside-in",
              "stagger": 0.08,
              "duration": 0.8,
              "labels": "show"
            },
            {
              "label": "CPUs and DIMMs",
              "parts": ["cpu-*", "dimm-*", "dimm-b-*"],
