    },
    {
      "caption": "GPU card out",
      "duration": 2,
      "assembly": [
        {
          "explode": "srv",
          "program": "suggested",
          "to": 2
        }
      ]
    },
    {
      "caption": "Heat sinks off",
      "duration": 2.2,
      "assembly": [
        {
          "explode": "srv",
          "program": "suggested",
          "to": 3
        }
      ]
    },
    {
      "caption": "CPUs and DIMMs up",
      "duration": 3.4,
      "assembly": [
        {
          "explode": "srv",
          "program": "suggested",
          "to": 4
        }
      ]
    },
    {
      "caption": "Board, fans and PSUs up",
      "duration": 3.3,
      "assembly": [
        {
          "explode": "srv",
          "program": "suggested",
          "to": 5
        }
      ]
    },
    {
      "caption": "Reassembled",
      "duration": 6.6,
      "assembly": [
        {
          "implode": "srv"
        }
      ]
    }
  ]
}
