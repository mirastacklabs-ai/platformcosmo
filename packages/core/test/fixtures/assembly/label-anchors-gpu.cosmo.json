  "steps": [
    {
      "caption": "Assembled 2U GPU server",
      "duration": 2
    },
    {
      "caption": "Lid off",
      "duration": 2,
      "assembly": [
        {
          "explode": "srv",
          "program": "suggested",
          "to": 1
