              "distance": "auto",
              "order": "outside-in",
              "stagger": 0.08,
              "duration": 0.8,
              "labels": "show"
            },
            {
              "label": "Board, fans, PSUs",
              "parts": ["board", "fan-*", "psu-*"],
              "direction": "+z",
              "distance": "auto",
              "order": "outside-in",
              "stagger": 0.08,
              "duration": 0.8,
              "labels": "show"
            }
          ]
        }
      ]
    }
