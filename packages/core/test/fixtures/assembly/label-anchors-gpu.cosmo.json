            {
              "label": "GPU card",
              "parts": ["gpu"],
              "direction": "+z",
              "distance": "auto",
              "order": "outside-in",
              "stagger": 0.08,
              "duration": 0.8,
              "labels": "show"
            },
            {
              "label": "Heat sinks",
              "parts": ["sink-*"],
