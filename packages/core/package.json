{
  "name": "@platformcosmo/core",
  "version": "0.0.0",
  "description": "PlatformCosmo core package (pre-alpha).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/core"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/v1.json": "./dist/schema/v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/LICENSES dist/schema && cp ../../LICENSES/Inter-OFL-1.1.txt dist/LICENSES/Inter-OFL-1.1.txt && cp ../../schema/v1.json dist/schema/v1.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "svgo": "4.1.0",
    "yaml": "2.9.1"
  }
}
