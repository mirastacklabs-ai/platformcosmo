{
  "name": "@platformcosmo/core",
  "version": "0.1.2",
  "description": "Deterministic engine that validates a platformcosmo spec and renders animated isometric SVG, PNG, GIF and MP4 architecture diagrams. No DOM, no network.",
  "keywords": [
    "platformcosmo",
    "architecture-diagram",
    "isometric",
    "svg",
    "diagram",
    "diagrams-as-code",
    "svg-animation",
    "renderer",
    "cloud-architecture",
    "data-center"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirastacklabs-ai/platformcosmo.git",
    "directory": "packages/core"
  },
  "homepage": "https://platformcosmo.io",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./schema/v1.json": "./dist/schema/v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && mkdir -p dist/LICENSES dist/schema && cp ../../LICENSES/Oswald-OFL-1.1.txt ../../LICENSES/JetBrainsMono-OFL-1.1.txt dist/LICENSES/ && cp ../../schema/v1.json dist/schema/v1.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "ajv": "^8.20.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "svgo": "4.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "dejavu-fonts-ttf": "2.37.3"
  }
}
