{
  "$schema": "https://platformcosmo.io/schema/v1.json",
  "meta": {
    "version": "1",
    "title": "From the hall to the heat sink",
    "description": "A data hall down to one CPU's heat sinks and back: rack close-up, a server built from its board plan, and a synthetic heat-sink installation figure as the deepest close-up."
  },
  "images": [
    {
      "id": "hs-base",
      "src": "data:image/png;base64,",
      "source": {
        "document": "Synthetic installation figure (scripts/gen-example-figures.mjs)",
        "figure": "Board"
      }
    },
    {
      "id": "hs-sprite",
      "src": "data:image/png;base64,",
      "source": {
        "document": "Synthetic installation figure (scripts/gen-example-figures.mjs)",
        "figure": "Heat sink"
      }
    }
  ],
  "figures": [
    {
      "id": "hs-install",
      "base": "hs-base",
      "pose": "exploded",
      "parts": [
        {
          "id": "hs-1",
          "image": "hs-sprite",
          "seat": [180, 280],
          "exploded": [180, 80],
          "label": "Heat sink"
        }
      ]
    }
  ],
  "assemblies": [
    {
      "id": "board-plan",
      "template": true,
      "units": "in",
      "labels": "always",
      "parts": [
        {
          "id": "pcb",
          "shape": "plate",
          "size": [13, 12, 0.06],
          "color": "green"
        },
        {
          "id": "cpu-1",
          "type": "socket",
          "at": [2, 6, 0.06],
          "size": [2.2, 2.2, 0.3],
          "label": "CPU 1",
          "closeup": "hs-install"
        },
        {
          "id": "cpu-2",
          "type": "socket",
          "at": [6, 6, 0.06],
          "size": [2.2, 2.2, 0.3],
          "label": "CPU 2",
          "closeup": "hs-install"
        },
        {
          "id": "dimm-bank",
          "type": "dimm-slot",
          "count": 4,
          "at": [9.5, 5, 0.06],
          "pitch": [0.4, 0, 0],
          "size": [0.25, 5.2, 0.4],
          "label": "DIMM"
        },
        {
          "id": "pci",
          "type": "pci-slot",
          "count": 5,
          "at": [1, 1, 0.06],
          "pitch": [0, 0.8, 0],
          "size": [3.5, 0.3, 0.45],
          "label": "PCI"
        },
        {
          "id": "bridge",
          "type": "chip",
          "at": [5, 3, 0.06],
          "size": [1.2, 1.2, 0.12],
          "label": "Chipset"
        },
        {
          "id": "battery",
          "type": "battery",
          "shape": "cylinder",
          "at": [11, 1, 0.06],
          "size": [0.8, 0.8, 0.12],
          "label": "Battery"
        }
      ]
    },
    {
      "id": "srv-2u",
      "template": true,
      "units": "mm",
      "parts": [
        {
          "id": "chassis",
          "shape": "hw:chassis-2u",
          "size": [430, 700, 85],
          "role": "shell"
        },
        {
          "id": "board",
          "use": "board-plan",
          "at": [40, 300, 4],
          "size": [330, 305, 12]
        },
        {
          "id": "fan",
          "type": "fan",
          "shape": "hw:fan",
          "count": 4,
          "at": [30, 230, 4],
          "pitch": [95, 0, 0],
          "size": [80, 38, 76],
          "label": "System fan"
        },
        {
          "id": "psu",
          "type": "psu",
          "shape": "hw:psu",
          "at": [315, 4, 4],
          "size": [95, 200, 76],
          "label": "Power supply"
        },
        {
          "id": "sled",
          "type": "drive",
          "count": 2,
          "at": [20, 620, 4],
          "pitch": [0, 0, 40],
          "size": [150, 75, 38],
          "label": "Drive sled"
        },
        {
          "id": "lid",
          "shape": "hw:lid",
          "at": [0, 0, 85],
          "size": [430, 700, 3],
          "role": "cover",
          "label": "Top cover"
        }
      ],
      "programs": [
        {
          "id": "assemble",
          "kind": "build",
          "steps": [
            {
              "caption": "Board",
              "add": ["board/pcb", "board/cpu-*", "board/bridge", "board/battery"]
            },
            {
              "caption": "Memory and PCI",
              "add": ["board/dimm-bank-*", "board/pci-*"]
            },
            {
              "caption": "Fans, PSU, drives",
              "add": ["fan-*", "psu", "sled-*"]
            },
            {
              "caption": "Cover",
              "add": ["lid"]
            }
          ]
        },
        {
          "id": "open",
          "stages": [
            {
              "label": "Cover",
              "parts": ["lid"],
              "direction": "up"
            }
          ]
        }
      ]
    }
  ],
  "racks": [
    {
      "id": "r1",
      "slots": [
        {
          "at": 20,
          "type": "server-2u"
        }
      ]
    },
    {
      "id": "r2",
      "slots": [
        {
          "id": "srv",
          "at": 20,
          "type": "server-2u",
          "label": "App server",
          "closeup": "srv-2u"
        }
      ]
    },
    {
      "id": "r3",
      "slots": [
        {
          "at": 20,
          "type": "server-2u"
        }
      ]
    },
    {
      "id": "r4",
      "slots": [
        {
          "at": 20,
          "type": "server-2u"
        }
      ]
    }
  ],
  "rows": [
    {
      "id": "row-a",
      "members": ["r1", "r2"]
    },
    {
      "id": "row-b",
      "members": ["r3", "r4"]
    }
  ],
  "aisles": [
    {
      "id": "cold",
      "kind": "cold",
      "rows": ["row-a", "row-b"]
    }
  ],
  "steps": [
    {
      "caption": "The hall",
      "duration": 2
    },
    {
      "caption": "Row A",
      "focus": "row-a",
      "duration": 2
    },
    {
      "caption": "Rack R2: the app server slides out",
      "assembly": [
        {
          "explode": "r2"
        }
      ],
      "focus": "r2",
      "duration": 4
    },
    {
      "caption": "Building the server",
      "assembly": [
        {
          "build": "r2/srv/closeup",
          "program": "assemble",
          "to": 3
        }
      ],
      "focus": "r2/srv/closeup",
      "duration": 8
    },
    {
      "caption": "The board: two CPU sockets",
      "focus": "r2/srv/closeup/board",
      "duration": 3
    },
    {
      "caption": "CPU 1: seating its heat sink",
      "assembly": [
        {
          "implode": "r2/srv/closeup/board/cpu-1/closeup"
        }
      ],
      "focus": "r2/srv/closeup/board/cpu-1/closeup",
      "duration": 5
    },
    {
      "caption": "Cover on",
      "assembly": [
        {
          "build": "r2/srv/closeup",
          "program": "assemble"
        }
      ],
      "focus": "r2/srv/closeup",
      "duration": 3
    },
    {
      "caption": "Back into the rack",
      "assembly": [
        {
          "implode": "r2"
        }
      ],
      "focus": "r2",
      "duration": 4
    },
    {
      "caption": "The hall",
      "duration": 2
    }
  ]
}
